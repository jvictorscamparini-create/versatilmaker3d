  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "start": "node build/server.mjs --production",
    "preview": "npm run start",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs && tsx scripts/model-check.ts && tsx scripts/data-check.ts"
  },
